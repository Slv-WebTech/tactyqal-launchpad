PORT=4000
DB_FILE=blog.db

# Writes are CLOSED unless you configure one of these:
#   ADMIN_KEY  - 24+ random chars (openssl rand -base64 32); clients send it as the x-admin-key header
#   ALLOW_OPEN_WRITES=1 - local development only: anyone can write. Refused when NODE_ENV=production.
ADMIN_KEY=
ALLOW_OPEN_WRITES=
